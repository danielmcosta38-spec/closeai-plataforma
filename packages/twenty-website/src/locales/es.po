#: src/platform/releases/ReleaseNotes.tsx
#. js-lingui-id: 9cL2b3
msgid "Watch recordings alongside their transcripts. Click a transcript entry to jump to that moment, and follow along with highlighted words and automatic scrolling during playback."
msgstr "Ve las grabaciones junto con sus transcripciones. Haz clic en una entrada de la transcripción para ir a ese momento y sigue el contenido con palabras resaltadas y desplazamiento automático durante la reproducción."

#: src/platform/releases/ReleaseNotes.tsx
#. js-lingui-id: k1Pevc
msgid "We are pleased to reopen the cloud subscription to everyone. No more waiting!"
msgstr "Nos complace reabrir la suscripción en la nube para todos. ¡No más esperas!"

#: src/sections/partner-signoff/PartnerSignoff.tsx
#. js-lingui-id: CtEyix
msgid "We certify real builders only. Every application is reviewed against a shipped Twenty project — send yours with proof."
msgstr "Solo certificamos a creadores reales. Cada solicitud se revisa en función de un proyecto de CloseAI entregado; envía el tuyo con pruebas."

