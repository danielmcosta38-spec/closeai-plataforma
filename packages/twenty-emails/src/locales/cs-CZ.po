#: src/emails/billing-trial-converting.email.tsx
#. js-lingui-explicit-id
msgid "If Twenty is working for you, you're all set — there's nothing to do. If it's not the right fit, you can cancel in one click before then and you won't be charged."
msgstr "Pokud vám CloseAI vyhovuje, je vše nastaveno — nemusíte dělat nic. Pokud vám nevyhovuje, můžete do té doby jedním kliknutím zrušit a nebude vám nic účtováno."

#: src/emails/server-admin-access-changed.email.tsx
#. js-lingui-explicit-id
msgid "If you did not expect this change, review your server administrators immediately."
msgstr "Pokud jste tuto změnu neočekávali, okamžitě zkontrolujte správce svého serveru."

#: src/emails/password-update-notify.email.tsx
#. js-lingui-explicit-id
msgid "If you did not initiate this change, please contact your workspace owner immediately."
msgstr "Pokud jste tuto změnu neiniciovali, prosím, okamžitě kontaktujte majitele vašeho pracovního prostoru."

#: src/emails/billing-trial-ending.email.tsx
#. js-lingui-explicit-id
msgid "If you do nothing, we'll pause your workspace and keep your data safe for {dataRetentionDays} days in case you change your mind — no card will be charged."
msgstr "Pokud neuděláte nic, pozastavíme váš pracovní prostor a vaše data budeme po dobu {dataRetentionDays} dní uchovávat v bezpečí pro případ, že si to rozmyslíte — z karty vám nebude nic účtováno."

#: src/emails/clean-suspended-workspace.email.tsx
#. js-lingui-explicit-id
msgid "If you'd ever like to give Twenty another try, you can start a fresh workspace in minutes — we'd love to have you back."
msgstr "Pokud byste chtěli CloseAI někdy znovu vyzkoušet, můžete během pár minut založit nový pracovní prostor — budeme rádi, když se vrátíte."

#: src/emails/server-admin-access-changed.email.tsx
#. js-lingui-explicit-id
msgid "Impersonation: {impersonateStatus}"
msgstr "Zosobnění: {impersonateStatus}"

#: src/components/WhatIsTwenty.tsx
#. js-lingui-explicit-id
msgid "It's a CRM, a software to help businesses manage their customer data and relationships efficiently."
msgstr "Je to CRM, software, který pomáhá firmám efektivně spravovat jejich zákaznická data a vztahy."

#: src/emails/clean-suspended-workspace.email.tsx
#. js-lingui-explicit-id
msgid "Its data has been removed and can no longer be recovered."
msgstr "Jeho data byla odstraněna a již je nelze obnovit."

