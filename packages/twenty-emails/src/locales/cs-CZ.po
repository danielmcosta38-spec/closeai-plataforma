#: src/emails/server-admin-access-changed.email.tsx
#. js-lingui-explicit-id
msgid "{actorName} updated server administrator access for {targetName} ({targetEmail})."
msgstr "{actorName} aktualizoval(a) přístup správce serveru pro {targetName} ({targetEmail})."

#: src/emails/send-invite-link.email.tsx
